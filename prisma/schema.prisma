// clientflow/prisma/schema.prisma
// ClientFlow v0.2 — SQLite (zero-config local dev).
//
// NOTE on database choice: the domain model is fully relational and
// Postgres-ready (see git history for the PostgreSQL variant). SQLite was
// chosen as the default because it needs no server, no password and no
// Docker — the app runs with a single file. To move to Postgres later:
// change provider to "postgresql", restore native enums / @db.Text and
// point DATABASE_URL at the server. All queries are plain Prisma, no raw SQL.
//
// SQLite has no native enums, so status/priority fields are Strings.
// Allowed values are enforced in backend/src/schemas/*.ts via Zod:
//   ClientStatus:  ACTIVE | INACTIVE | LEAD
//   ProjectStatus: PLANNING | ACTIVE | ON_HOLD | COMPLETED
//   Priority:      LOW | MEDIUM | HIGH
//   TaskStatus:    TODO | IN_PROGRESS | DONE
//   RequestStatus: OPEN | IN_PROGRESS | CONVERTED | DECLINED
//   Visibility:    INTERNAL | SHARED
//   AuthorRole:    PRO | CLIENT
//
// NOTE on database choice: the domain model is fully relational and
// Postgres-ready (see git history for the PostgreSQL variant). SQLite was
// chosen as the default because it needs no server, no password and no
// Docker — the app runs with a single file. To move to Postgres later:
// change provider to "postgresql", restore native enums / @db.Text and
// point DATABASE_URL at the server. All queries are plain Prisma, no raw SQL.
//
// SQLite has no native enums, so status/priority fields are Strings.
// Allowed values are enforced in backend/src/schemas/*.ts via Zod:
//   ClientStatus:  ACTIVE | INACTIVE | LEAD
//   ProjectStatus: PLANNING | ACTIVE | ON_HOLD | COMPLETED
//   Priority:      LOW | MEDIUM | HIGH
//   TaskStatus:    TODO | IN_PROGRESS | DONE

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  clients      Client[]
  projects     Project[]
  tasks        Task[]
  notes        Note[]
  activities   Activity[]
  requests     ClientRequest[]
  comments     Comment[]
  notifications Notification[]
  automations  AutomationRule[]

  @@index([email])
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  company   String?
  email     String?
  phone     String?
  notes     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]
  tasks     Task[]
  notesList Note[]
  requests  ClientRequest[]
  // Client Portal (v0.2): magic-link access scoped to this client only.
  portalEnabled Boolean @default(false)
  portalToken   String? @unique

  @@index([userId])
  @@index([userId, status])
  @@index([userId, name])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("PLANNING")
  priority    String   @default("MEDIUM")
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  notesList   Note[]
  requests    ClientRequest[]
  comments    Comment[]
  // Visible in the Client Portal when true (professional controls this).
  isShared    Boolean  @default(false)

  @@index([userId])
  @@index([clientId])
  @@index([userId, status])
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("TODO")
  priority    String   @default("MEDIUM")
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    Comment[]
  // Visible in the Client Portal only when true AND the parent project is shared.
  isShared    Boolean  @default(false)

  @@index([userId])
  @@index([projectId])
  @@index([clientId])
  @@index([userId, status])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // INTERNAL = professional only. SHARED = also visible in the Client Portal.
  visibility String @default("INTERNAL")

  @@index([userId])
  @@index([clientId])
  @@index([projectId])
}

model Activity {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  message    String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// ── v0.2: collaboration ──────────────────────────────────

model ClientRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  // CLIENT = created from the portal, PRO = created by the professional.
  createdBy   String   @default("PRO")
  // Task created when this request is converted (Request → Task flow).
  taskId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    Comment[]

  @@index([userId])
  @@index([clientId])
  @@index([userId, status])
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestId  String?
  request    ClientRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorName String
  authorRole String   @default("PRO")
  // INTERNAL = professional only. SHARED = visible in the Client Portal.
  visibility String   @default("INTERNAL")
  content    String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([requestId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model AutomationRule {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Trigger: project.completed | task.completed | task.overdue | request.created
  trigger   String
  // Action: create_task | create_activity | create_notification
  action    String
  // JSON config, e.g. {"title":"Follow up","priority":"MEDIUM"}
  config    String    @default("{}")
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, trigger])
}
