// clientflow/prisma/schema.prisma
// ClientFlow v0.2 — SQLite (zero-config local dev).
//
// NOTE on database choice: the domain model is fully relational and
// Postgres-ready (see git history for the PostgreSQL variant). SQLite was
// chosen as the default because it needs no server, no password and no
// Docker — the app runs with a single file. To move to Postgres later:
// change provider to "postgresql", restore native enums / @db.Text and
// point DATABASE_URL at the server. All queries are plain Prisma, no raw SQL.
//
// SQLite has no native enums, so status/priority fields are Strings.
// Allowed values are enforced in backend/src/schemas/*.ts via Zod:
//   ClientStatus:  ACTIVE | INACTIVE | LEAD
//   ProjectStatus: PLANNING | ACTIVE | ON_HOLD | COMPLETED
//   Priority:      LOW | MEDIUM | HIGH
//   TaskStatus:    TODO | IN_PROGRESS | DONE
//   RequestStatus: OPEN | IN_PROGRESS | CONVERTED | DECLINED
//   Visibility:    INTERNAL | SHARED
//   AuthorRole:    PRO | CLIENT
//
// NOTE on database choice: the domain model is fully relational and
// Postgres-ready (see git history for the PostgreSQL variant). SQLite was
// chosen as the default because it needs no server, no password and no
// Docker — the app runs with a single file. To move to Postgres later:
// change provider to "postgresql", restore native enums / @db.Text and
// point DATABASE_URL at the server. All queries are plain Prisma, no raw SQL.
//
// SQLite has no native enums, so status/priority fields are Strings.
// Allowed values are enforced in backend/src/schemas/*.ts via Zod:
//   ClientStatus:  ACTIVE | INACTIVE | LEAD
//   ProjectStatus: PLANNING | ACTIVE | ON_HOLD | COMPLETED
//   Priority:      LOW | MEDIUM | HIGH
//   TaskStatus:    TODO | IN_PROGRESS | DONE

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Roles & Permissions ──────────────────────────────────────
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  users       User[]       @relation("UserOrganization")
  clients     Client[]
  projects    Project[]
  tasks       Task[]
  notes       Note[]
  activities  Activity[]
  requests    ClientRequest[]
  comments    Comment[]
  notifications Notification[]
  automations AutomationRule[]
  sandboxes   DemoSandbox[]
  auditLogs   AuditLog[]

  @@index([slug])
}

// For backward compatibility during migration - organizationId is optional initially
// Will be made required after backfill

model Membership {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrganizationRole  @default(MEMBER)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  tokenVersion  Int          @default(0)
  platformRole  String       @default("USER") // USER | ADMIN
  organizationId String?
  organization  Organization? @relation("UserOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  organizations Membership[]
  clients       Client[]
  projects      Project[]
  tasks         Task[]
  notes         Note[]
  activities    Activity[]
  requests      ClientRequest[]
  comments      Comment[]
  notifications Notification[]
  automations   AutomationRule[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([organizationId])
}

model Client {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name          String
  company       String?
  email         String?
  phone         String?
  notes         String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  projects      Project[]
  tasks         Task[]
  notesList     Note[]
  requests      ClientRequest[]
  // Client Portal (v0.2): magic-link access scoped to this client only.
  portalEnabled Boolean  @default(false)
  portalToken   String?  @unique

  @@index([userId])
  @@index([organizationId])
  @@index([userId, status])
  @@index([userId, name])
}

model Project {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        String   @default("PLANNING")
  priority      String   @default("MEDIUM")
  startDate     DateTime?
  dueDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tasks         Task[]
  notesList     Note[]
  requests      ClientRequest[]
  comments      Comment[]
  // Visible in the Client Portal when true (professional controls this).
  isShared      Boolean  @default(false)

  @@index([userId])
  @@index([organizationId])
  @@index([clientId])
  @@index([userId, status])
}

model Task {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        String   @default("TODO")
  priority      String   @default("MEDIUM")
  dueDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  comments      Comment[]
  // Visible in the Client Portal only when true AND the parent project is shared.
  isShared      Boolean  @default(false)

  @@index([userId])
  @@index([organizationId])
  @@index([projectId])
  @@index([clientId])
  @@index([userId, status])
}

model Note {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String?
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // INTERNAL = professional only. SHARED = also visible in the Client Portal.
  visibility    String   @default("INTERNAL")

  @@index([userId])
  @@index([organizationId])
  @@index([clientId])
  @@index([projectId])
}

model Activity {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  type          String
  message       String
  entityType    String?
  entityId      String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([userId, createdAt])
}

// ── v0.2: collaboration ──────────────────────────────────

model ClientRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  priority      String   @default("MEDIUM")
  status        String   @default("OPEN")
  // CLIENT = created from the portal, PRO = created by the professional.
  createdBy     String   @default("PRO")
  // Task created when this request is converted (Request → Task flow).
  taskId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  comments      Comment[]

  @@index([userId])
  @@index([organizationId])
  @@index([clientId])
  @@index([userId, status])
}

model Comment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestId     String?
  request       ClientRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorName    String
  authorRole    String   @default("PRO")
  // INTERNAL = professional only. SHARED = visible in the Client Portal.
  visibility    String   @default("INTERNAL")
  content       String
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([projectId])
  @@index([taskId])
  @@index([requestId])
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  type          String
  message       String
  entityType    String?
  entityId      String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([userId, createdAt])
}

model AutomationRule {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name          String
  // Trigger: project.completed | task.completed | task.overdue | request.created
  trigger       String
  // Action: create_task | create_activity | create_notification
  action        String
  // JSON config, e.g. {"title":"Follow up","priority":"MEDIUM"}
  config        String    @default("{}")
  enabled       Boolean   @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([userId, trigger])
}

// ── Demo Sandbox (ephemeral per-visitor) ─────────────────────
model DemoSandbox {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitorId      String   @unique // hashed fingerprint / anonymous id
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([expiresAt])
  @@index([visitorId])
}

// ── Audit Log (inmutable, append-only) ───────────────────────
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  requestId      String   @unique // correlation ID (e.g., request.id header)
  action         String   // e.g., "client.created", "user.password_changed", "settings.updated"
  resourceType   String   // e.g., "Client", "User", "Project", "Organization"
  resourceId     String?
  oldData        String?  // JSON string of previous state (null for creates)
  newData        String?  // JSON string of new state (null for deletes)
  ipAddress      String?
  userAgent      String?
  statusCode     Int
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}
